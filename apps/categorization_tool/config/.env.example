ENV=.env
SERVICE_NAME="Categorization Tool"
SERVICE_HOST=
SERVICE_PORT=

DB_CONNECTION=postgres
DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_PORT=
DB_SYNCHRONIZE=false
DB_LOGGING=true

LOG_ERROR_FILE=error.log
LOG_COMBINED_FILE=combined.log
LOG_LEVEL=info

REDIS_HOST=localhost
REDIS_PORT=6379

DIR_SAVE_SCREENSHOTS=
ETHERSCAN_API_URL=https://api.etherscan.io/api
ETHERSCAN_API_KEY=
BSCSCAN_API_URL=https://api.bscscan.io/api
BSCSCAN_API_KEY=
TENDERLY_API_URL=https://api.tenderly.co/api
# this parameter is optional, but keep in mind that
# if not provided then all requests to github is done without authntication with rate limit of 60 requests per hour
GITHUB_OAUTH_TOKEN=
