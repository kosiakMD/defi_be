ENV=.env.development.local
SERVICE_NAME="Price Service Crawlers"
SERVICE_HOST=
SERVICE_PORT=

REDIS_HOST=
REDIS_PORT=
REDIS_AUTH=

LOG_ERROR_FILE=error.log
LOG_COMBINED_FILE=combined.log
LOG_LEVEL=info
LOG_IN_JSON=false
SENTRY_DSN=

CURRENT_PRICE_SECONDS_INTERVAL=300
HISTORY_PRICE_SECONDS_INTERVAL=3600

THEGRAPH_UNISWAP_ENDPOINT=https://api.thegraph.com/subgraphs/name/tretiakpk/uniswap-v2
