{
  "name": "@app/common",
  "version": "1.0.3",
  "description": "Common",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "author": "",
  "private": true,
  "license": "ISC",
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint \"**/{src,apps,libs,test}/**/*.ts\"",
    "lint-fix": "eslint \"**/{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format-check": "prettier \"./**/src/**/*.ts\" \"./**/test/**/*.ts\" --check"
  },
  "dependencies": {
    "@ethersproject/providers": "5.4.5",
    "@indexed-finance/multicall": "^2.0.0",
    "@nestjs/axios": "0.0.2",
    "@nestjs/swagger": "^4.8.2",
    "@raydium-io/raydium-sdk": "1.0.1-beta.7",
    "@solana/spl-name-service": "^0.1.3",
    "@solana/web3.js": "^1.32.0",
    "@tns-money/tns.js": "^1.2.0",
    "bn.js": "^4.12.0",
    "class-validator": "^0.12.2",
    "helmet": "^5.0.2",
    "http-proxy-middleware": "^1.1.0",
    "nest-winston": "^1.4.1",
    "rxjs": "^6.6.6",
    "uuid": "^8.3.2",
    "web3": "^1.6.0",
    "winston-aws-cloudwatch": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "exports": {
    ".": "./dist/index.js",
    "./enum": "./dist/enum/index.js",
    "./dto": "./dist/dto/index.js",
    "./dto/nft": "./dist/dto/nft/index.js",
    "./dto/opportunities": "./dist/dto/opportunities/index.js",
    "./interfaces": "./dist/interfaces/index.js",
    "./utils": "./dist/utils/index.js",
    "./decorators": "./dist/decorators/index.js",
    "./config/configuration": "./dist/config/configuration.js"
  },
  "typesVersions": {
    "*": {
      "enum": [
        "dist/enum/index.d.ts"
      ],
      "dto": [
        "dist/dto/index.d.ts"
      ],
      "dto/nft": [
        "dist/dto/nft/index.d.ts"
      ],
      "dto/opportunities": [
        "dist/dto/opportunities/index.d.ts"
      ],
      "interfaces": [
        "dist/interfaces/index.d.ts"
      ],
      "utils": [
        "dist/utils/index.d.ts"
      ],
      "decorators": [
        "dist/decorators/index.d.ts"
      ],
      "config/configuration": [
        "dist/config/configuration.d.ts"
      ]
    }
  }
}
