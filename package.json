    "assets-prebuild": "yarn yarn --cwd ./apps/assets run prebuild",
    "assets-build": "nest build assets",
    "assets-prestart-fix": "bash ./apps/assets/require_es_module_fix.sh",
    "assets-start": "yarn assets-prestart-fix && nest start assets",
    "assets-start:dev": "yarn assets-prestart-fix && nest start assets --watch",
    "assets-start:debug": "yarn assets-prestart-fix && nest start assets --debug 0.0.0.0:9229 --watch",
    "assets-start:prod": "yarn assets-prestart-fix && nest start assets",
    "assets-migration:generate-dev": "ts-node --project ./apps/assets/tsconfig.app.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -f 'apps/assets/ormconfig-dev.ts'",
    "assets-migration:create": "ts-node --project ./apps/assets/tsconfig.app.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create -f 'apps/assets/ormconfig-dev.ts'",
    "assets-migration:run-dev": "ts-node --project ./apps/assets/tsconfig.app.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -f 'apps/assets/ormconfig-dev.ts'",
    "assets-migration:revert-dev": "ts-node --project ./apps/assets/tsconfig.app.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -f 'apps/assets/ormconfig-dev.ts'",
    "assets-migration:run": "node ./node_modules/typeorm/cli.js migration:run -f 'dist/apps/assets/src/ormconfig.js'",
    "assets-migration:revert": "node ./node_modules/typeorm/cli.js migration:revert -f 'dist/apps/assets/src/ormconfig.js'",
