SWAP_0X_ENDPOINT=https://api.0x.org/swap/v1/

ETH_URL=https://mainnet.infura.io/v3/d38bddd842b94305a23f91596991a9eb
BSC_URL=https://bsc-dataseed.binance.org/


DB_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_PORT=
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_ENTITIES=entities/**/*.ts

MONGO_HOST=
MONGO_PORT=
