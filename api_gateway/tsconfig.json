{
	"compilerOptions": {
		"module": "commonjs",
		"declaration": true,
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"lib": ["es5", "es6", "es2019"],
		"target": "es2019",
		"sourceMap": true,
		"outDir": "./dist",
		"baseUrl": "./",
		"incremental": true
	}
}
