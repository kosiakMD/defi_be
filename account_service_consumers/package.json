{
  "name": "account_service_consumers",
  "version": "0.0.1",
  "description": "Account Service Consumers",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=10.13.0",
    "npm": "^6.11.0 || ^7.5.6",
    "yarm": ">=1.13.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "build": "nest build migration-consumer && nest build migration-transactions-consumer && nest build migration-token-consumer",
    "build:migration-consumer": "nest build migration-consumer",
    "start-dev:migration-consumer": "nest start --watch migration-consumer",
    "start-prod:migration-consumer": "node dist/apps/migration_consumer/main",
    "build:migration-transactions-consumer": "nest build migration-transactions-consumer",
    "start-dev:migration-transactions-consumer": "nest start --watch migration-transactions-consumer",
    "start-prod:migration-transactions-consumer": "node dist/apps/migration_transactions_consumer/main",
    "build:migration-token-consumer": "nest build migration-token-consumer",
    "start-dev:migration-token-consumer": "nest start --watch migration-token-consumer",
    "start-prod:migration-token-consumer": "node dist/apps/migration_token_consumer/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/burger-worker/test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^7.0.0",
    "@nestjs/config": "^0.6.3",
    "@nestjs/core": "^7.0.0",
    "@nestjs/microservices": "^7.4.3",
    "@nestjs/platform-express": "^7.0.0",
    "@nestjs/swagger": "^4.8.1",
    "@nestjs/typeorm": "^7.1.5",
    "amqp-connection-manager": "^3.2.0",
    "amqplib": "^0.6.0",
    "fastify-swagger": "^4.8.0",
    "joi": "^17.4.0",
    "nest-winston": "^1.5.0",
    "pg": "^8.6.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^6.6.7",
    "swagger-ui-express": "^4.1.6",
    "typeorm": "^0.2.34",
    "web3": "^1.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^7.0.0",
    "@nestjs/schematics": "^7.0.0",
    "@nestjs/testing": "^7.0.0",
    "@types/express": "^4.17.3",
    "@types/jest": "26.0.10",
    "@types/node": "^13.9.1",
    "@types/supertest": "^2.0.8",
    "@typescript-eslint/eslint-plugin": "3.9.1",
    "@typescript-eslint/parser": "3.9.1",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "eslint": "7.7.0",
    "eslint-config-prettier": "^6.10.0",
    "eslint-plugin-import": "^2.20.1",
    "jest": "26.4.2",
    "prettier": "^1.19.1",
    "supertest": "^4.0.2",
    "ts-jest": "26.2.0",
    "ts-loader": "^6.2.1",
    "ts-node": "9.0.0",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^3.7.4",
    "winston": "^3.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "@app/shared/(.*)": "<rootDir>/libs/shared/src/$1",
      "@app/shared": "<rootDir>/libs/shared/src"
    }
  }
}
