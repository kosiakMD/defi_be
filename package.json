{
  "name": "defiyield-backend",
  "version": "1.0.1",
  "description": "DeFiYield Microservices",
  "engines": {
    "node": ">=14",
    "npm": "^6.11.0 || ^7.5.6",
    "yarn": ">=1.13.0"
  },
  "scripts": {
    "begin": "yarn add group-dependencies@git+https://github.com/defiyield-info/group-dependencies#v0.1.0-beta.9",
    "pre-commit": "yarn run lint && yarn run format-check",
    "prepare": "husky install",
    "build-monorepo": "yarn common-build && yarn gateway-build && yarn account-build && yarn integration-build && yarn price-build",
    "lint": "eslint \"**/{src,apps,libs,test}/**/*.ts\"",
    "lint-fix": "eslint \"**/{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format-check": "prettier \"./**/src/**/*.ts\" \"./**/test/**/*.ts\" --check",
    "common-build": "nest build common",
    "gateway-prebuild": "yarn --cwd ./apps/api_gateway run prebuild",
    "gateway-format": "yarn --cwd ./apps/api_gateway run format",
    "gateway-lint": "eslint \"./apps/api_gateway/{src,config,test}/**/*.ts\"",
    "gateway-build": "nest build api_gateway",
    "gateway-start:dev": "nest start api_gateway --watch",
    "gateway-start:debug": "nest start api_gateway --debug --watch",
    "gateway-start:prod": "nest start api_gateway",
    "account-format": "yarn --cwd ./apps/account_service run format",
    "account-lint": "eslint \"./apps/account_service/{src,config,test}/**/*.ts\"",
    "account-prebuild": "yarn yarn --cwd ./apps/account_service run prebuild",
    "account-build": "nest build account_service",
    "account-start": "nest start account_service",
    "account-start:dev": "nest start account_service --watch",
    "account-start:debug": "nest start account_service --debug --watch",
    "account-start:prod": "nest start account_service",
    "integration-format": "yarn --cwd ./apps/integration_service run format",
    "integration-lint": "eslint \"./apps/integration_service/{src,config}/**/*.ts\"",
    "integration-prebuild": "yarn yarn --cwd ./apps/integration_service run prebuild",
    "integration-build": "nest build integration_service",
    "integration-start": "nest start integration_service",
    "integration-start:dev": "nest start integration_service --watch",
    "integration-start:debug": "nest start integration_service --debug --watch",
    "integration-start:prod": "nest start integration_service",
    "price-format": "yarn --cwd ./apps/price_service run format",
    "price-lint": "eslint \"./apps/price_service/{src,config}/**/*.ts\"",
    "price-prebuild": "yarn yarn --cwd ./apps/price_service run prebuild",
    "price-build": "nest build price_service",
    "price-start": "nest start price_service",
    "price-start:dev": "nest start price_service --watch",
    "price-start:debug": "nest start price_service --debug --watch",
    "price-start:prod": "nest start price_service",
    "price_crawlers-format": "yarn --cwd ./jobs/price_crawlers run format",
    "price_crawlers-lint": "eslint \"./jobs/price_crawlers/{src,config}/**/*.ts\"",
    "price_crawlers-prebuild": "rimraf ./dist/jobs/price_crawlers",
    "price_crawlers-build": "nest build price_crawlers",
    "price_crawlers-start": "nest start price_crawlers",
    "price_crawlers-start:dev": "nest start price_crawlers --watch",
    "price_crawlers-start:debug": "nest start price_crawlers --debug --watch",
    "price_crawlers-start:prod": "nest start price_crawlers",
    "migration_chain_crawler-format": "yarn --cwd ./jobs/migration_chain_crawler run format",
    "migration_chain_crawler-lint": "eslint \"./jobs/migration_chain_crawler/{src,config}/**/*.ts\"",
    "migration_chain_crawler-prebuild": "rimraf ./dist/jobs/migration_chain_crawler",
    "migration_chain_crawler-build": "nest build migration_chain_crawler",
    "migration_chain_crawler-start": "nest start migration_chain_crawler",
    "migration_chain_crawler-start:dev": "nest start migration_chain_crawler --watch",
    "migration_chain_crawler-start:debug": "nest start migration_chain_crawler --debug --watch",
    "migration_chain_crawler-start:prod": "nest start migration_chain_crawler",
    "migration_chain_crawler-test": "yarn --cwd ./jobs/migration_chain_crawlers run jest",
    "migration_chain_crawler-test:watch": "yarn --cwd ./jobs/migration_chain_crawlers run jest --watch",
    "migration_chain_crawler-test:cov": "yarn --cwd ./jobs/migration_chain_crawlers run jest --coverage",
    "migration_chain_crawler-test:debug": "node ./jobs/migration_chain_crawlers/main.js --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "migration_chain_crawler-test:e2e": "yarn --cwd ./jobs/migration_chain_crawlers run jest --config test/jest-e2e.json",
    "migration_events_consumer-format": "yarn --cwd ./jobs/migration_events_consumer run format",
    "migration_events_consumer-lint": "eslint \"./jobs/migration_events_consumer/{src,config}/**/*.ts\"",
    "migration_events_consumer-prebuild": "rimraf ./dist/jobs/migration_events_consumer",
    "migration_events_consumer-build": "nest build migration_events_consumer",
    "migration_events_consumer-start": "nest start migration_events_consumer",
    "migration_events_consumer-start:dev": "nest start migration_events_consumer --watch",
    "migration_events_consumer-start:debug": "nest start migration_events_consumer --debug --watch",
    "migration_events_consumer-start:prod": "nest start migration_events_consumer",
    "migration_transactions_consumer-format": "yarn --cwd ./jobs/migration_transactions_consumer run format",
    "migration_transactions_consumer-lint": "eslint \"./jobs/migration_transactions_consumer/{src,config}/**/*.ts\"",
    "migration_transactions_consumer-prebuild": "rimraf ./dist/jobs/migration_transactions_consumer",
    "migration_transactions_consumer-build": "nest build migration_transactions_consumer",
    "migration_transactions_consumer-start": "nest start migration_transactions_consumer",
    "migration_transactions_consumer-start:dev": "nest start migration_transactions_consumer --watch",
    "migration_transactions_consumer-start:debug": "nest start migration_transactions_consumer --debug --watch",
    "migration_transactions_consumer-start:prod": "nest start migration_transactions_consumer",
    "migration_token_consumer-format": "yarn --cwd ./jobs/migration-token-consumer run format",
    "migration_token_consumer-lint": "eslint \"./jobs/migration-token-consumer/{src,config}/**/*.ts\"",
    "migration_token_consumer-prebuild": "rimraf ./dist/jobs/migration-token-consumer",
    "migration_token_consumer-build": "nest build migration-token-consumer",
    "migration_token_consumer-start": "nest start migration-token-consumer",
    "migration_token_consumer-start:dev": "nest start migration-token-consumer --watch",
    "migration_token_consumer-start:debug": "nest start migration-token-consumer --debug --watch",
    "migration_token_consumer-start:prod": "nest start migration-token-consumer",
    "lambda_vault-format": "yarn --cwd jobs/lambda_vaults run format",
    "lambda_vault-lint": "eslint \"jobs/lambda_vaults/{src,config}/**/*.ts\"",
    "lambda_vault-prebuild": "rimraf ./dist/jobs/lambda_vaults",
    "lambda_vault-build": "nest build lambda_vaults",
    "lambda_vault-start": "node -r dotenv/config node_modules/.bin/nest start lambda_vaults dotenv_config_path=jobs/lambda_vaults/.env",
    "lambda_vault-start:dev": "node -r dotenv/config node_modules/.bin/nest start lambda_vaults dotenv_config_path=jobs/lambda_vaults/.env --watch",
    "lambda_vault-start:debug": "nest start lambda_vaults --debug --watch",
    "lambda_vault-start:prod": "nest start lambda_vaults",
    "lambda_vault-test": "yarn --cwd ./jobs/lambda_vaults run jest",
    "lambda_vault-test:watch": "yarn --cwd ./jobs/lambda_vaults run jest --watch",
    "lambda_vault-test:cov": "yarn --cwd ./jobs/lambda_vaults run jest --coverage",
    "lambda_vault-test:debug": "node ./jobs/lambda_vaults/main.js --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "lambda_vault-test:e2e": "yarn --cwd ./jobs/lambda_vaults run jest --config test/jest-e2e.json",
    "lambda_prices-prebuild": "rimraf ./dist/jobs/lambda_prices",
    "lambda_prices-format": "yarn --cwd jobs/lambda_prices run format",
    "lambda_prices-lint": "eslint \"jobs/lambda_prices/{src,config,test}/**/*.ts\"",
    "lambda_prices-build": "nest build lambda_prices",
    "lambda_prices-test": "yarn --cwd jobs/lambda_prices mocha tests/unit/",
    "lambda_prices-start": "tsc --project jobs/lambda_prices/tsconfig.json && node ./dist/jobs/lambda_prices/src/start.js",
    "lambda_prices-start:dev": "nest start lambda_prices --watch",
    "lambda_prices-start:debug": "nest start lambda_prices --debug --watch",
    "lambda_prices-start:prod": "nest start lambda_prices",
    "lambda_prices-compile": "tsc --project jobs/lambda_prices/tsconfig.json",
    "lambda_prices-dev": "ts-node jobs/lambda_prices/src/start.ts",
    "lambda_protocol_prices-format": "yarn --cwd ./apps/lambda_protocol_prices run format",
    "lambda_protocol_prices-lint": "eslint \"./apps/lambda_protocol_prices/{src,config}/**/*.ts\"",
    "lambda_protocol_prices-prebuild": "yarn yarn --cwd ./apps/lambda_protocol_prices run prebuild",
    "lambda_protocol_prices-build": "nest build lambda_protocol_prices",
    "lambda_protocol_prices-start": "node -r dotenv/config node_modules/.bin/nest start lambda_protocol_prices dotenv_config_path=jobs/lambda_protocol_prices/.env",
    "lambda_protocol_prices-start:dev": "node -r dotenv/config node_modules/.bin/nest start lambda_protocol_prices dotenv_config_path=jobs/lambda_protocol_prices/.env --watch",
    "lambda_protocol_prices-start:debug": "nest start lambda_protocol_prices --debug --watch",
    "lambda_protocol_prices-start:prod": "nest start lambda_protocol_prices",
    "lambda_external_prices-prebuild": "rimraf ./dist/jobs/lambda_external_prices",
    "lambda_external_prices-format": "yarn --cwd jobs/lambda_external_prices run format",
    "lambda_external_prices-lint": "eslint \\\"jobs/lambda_external_prices/{src,config,test}/**/*.ts\\\"",
    "lambda_external_prices-build": "nest build lambda_external_prices",
    "lambda_external_prices-test": "yarn --cwd jobs/lambda_external_prices mocha tests/unit/",
    "lambda_external_prices-start:dev": "nest start lambda_external_prices --watch",
    "lambda_external_prices-start:debug": "nest start lambda_external_prices --debug --watch",
    "lambda_external_prices-start:prod": "nest start lambda_external_prices",
    "lambda_external_prices-compile": "tsc --project jobs/lambda_external_prices/tsconfig.json",
    "lambda_external_prices-dev": "ts-node jobs/lambda_external_prices/src/start.ts",
    "lambda_external_prices-start": "tsc --project jobs/lambda_external_prices/tsconfig.app.json && node ./dist/jobs/lambda_external_prices/src/start.js",
    "migration": "npm run build-monorepo && ts-node ./node_modules/typeorm/cli.js migration:run",
    "migration:generate": "ts-node ./node_modules/typeorm/cli.js migration:generate",
    "migration:create": "ts-node ./node_modules/typeorm/cli.js migration:create",
    "migration:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defiyield-info/defiyield-backend-v2.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
