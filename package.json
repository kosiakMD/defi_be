{
  "name": "defiyield-backend",
  "version": "1.0.0",
  "description": "DeFiYield Microservices",
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "install_all": "npm install & npm install --prefix api_gateway & npm install --prefix account_service & npm install --prefix integration_service & npm install --prefix swap_service & npm install --prefix price_service",
    "update": "npm update & npm update --prefix api_gateway & npm update --prefix account_service & npm update --prefix integration_service & npm update --prefix swap_service & npm update --prefix price_service",
    "build": "npm run build & npm run build --prefix api_gateway & npm run build --prefix account_service & npm run build --prefix integration_service & npm run build --prefix swap_service & npm run build --prefix price_service",
    "prebuild_gateway": "npm run prebuild --prefix api_gateway",
    "build_gateway": "npm run build --prefix api_gateway",
    "format_gateway": "npm run format --prefix api_gateway",
    "start_gateway": "npm run start --prefix api_gateway",
    "start_gateway:dev": "npm run start --prefix api_gateway",
    "start_gateway:debug": "npm run start --prefix api_gateway",
    "start_gateway:prod": "npm run start --prefix api_gateway",
    "prebuild_account": "npm run prebuild --prefix account_service",
    "build_account": "npm run build --prefix account_service",
    "format_account": "npm run format --prefix account_service",
    "start_account": "npm run start --prefix account_service",
    "start_account:dev": "npm run start --prefix account_service",
    "start_account:debug": "npm run start --prefix account_service",
    "start_account:prod": "npm run start --prefix account_service",
    "prebuild_integration": "npm run prebuild --prefix integration_service",
    "build_integration": "npm run build --prefix integration_service",
    "format_integration": "npm run format --prefix integration_service",
    "start_integration": "npm run start --prefix integration_service",
    "start_integration:dev": "npm run start --prefix integration_service",
    "start_integration:debug": "npm run start --prefix integration_service",
    "start_integration:prod": "npm run start --prefix integration_service",
    "prebuild_swap": "npm run prebuild --prefix swap_service",
    "build_swap": "npm run build --prefix swap_service",
    "format_swap": "npm run format --prefix swap_service",
    "start_swap": "npm run start --prefix swap_service",
    "start_swap:dev": "npm run start --prefix swap_service",
    "start_swap:debug": "npm run start --prefix swap_service",
    "start_swap:prod": "npm run start --prefix swap_service",
    "prebuild_price": "npm run prebuild --prefix price_service",
    "build_price": "npm run build --prefix price_service",
    "format_price": "npm run format --prefix price_service",
    "start_price": "npm run start --prefix price_service",
    "start_price:dev": "npm run start --prefix price_service",
    "start_price:debug": "npm run start --prefix price_service",
    "start_price:prod": "npm run start --prefix price_service"
