    "nestjs-agenda": "^2.0.0",
    "nestjs-config": "^1.4.7",
    "nestjs-pgpromise": "^1.4.3",
    "pg": "^8.5.1",
    "rxjs": "^7.3.0",
    "source-map-support": "^0.5.20",
    "tor-axios": "^1.0.9",
    "typeorm": "^0.2.37",
    "uuid": "^8.3.2",
    "web3": "^1.6.0",
    "winston": "^3.3.3",
    "winston-aws-cloudwatch": "^3.0.0"
  },
  "commonDependencies": [
    "@nestjs/axios",
    "@nestjs/common",
    "@nestjs/config",
    "@nestjs/core",
    "@nestjs/platform-express",
    "@nestjs/terminus",
    "@nestjs/typeorm",
    "axios",
