{
  "name": "lambda-prices-cleanup",
  "version": "1.0.2",
  "main": "index.js",
  "scripts": {
    "test": "mocha tests/unit/",
    "compile": "tsc",
    "cleanup": "rm -rf dist && rm -rf output",
    "build": "yarn && yarn cleanup && yarn compile && mkdir output && mv node_modules dist/node_modules && cd dist && zip -r ../output/lambda.zip *",
    "start": "tsc && node dist/index.js",
    "dev": "ts-node ./src/start.ts"
  },
  "dependencies": {
    "@sentry/serverless": "^6.17.2",
    "dotenv": "^10.0.0",
    "pg": "^8.7.1",
    "typescript": "^4.2.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.51",
    "@types/pg": "^8.6.1"
  },
  "gitHead": "b3197560b65251c1f02d7e22fba26e81b800ff18"
}
