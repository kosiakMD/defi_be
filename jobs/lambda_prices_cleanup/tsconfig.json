{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2017",
    "lib": ["es2019", "es2017", "dom"],
    "noImplicitAny": true,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
