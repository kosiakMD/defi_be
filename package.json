  "scripts": {
    "pre-commit": "yarn run lint && yarn run format-check",
    "prepare": "husky install",
    "build-monorepo": "yarn common-build && yarn gateway-build && yarn account-build && yarn integration-build && yarn price-build",
    "test-monorepo": "yarn integration-test",
    "lint": "eslint \"**/{src,apps,libs,test}/**/*.ts\"",
    "lint-fix": "eslint \"**/{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format-check": "prettier \"./**/src/**/*.ts\" \"./**/test/**/*.ts\" --check",
    "common-build": "nest build common",
    "gateway-prebuild": "yarn --cwd ./apps/gateway run prebuild",
    "gateway-format": "yarn --cwd ./apps/gateway run format",
    "gateway-lint": "eslint \"./apps/gateway/{src,config,test}/**/*.ts\"",
    "gateway-build": "nest build gateway",
    "gateway-start:dev": "nest start gateway --watch",
    "gateway-start:debug": "nest start gateway --debug --watch",
    "gateway-start:prod": "nest start gateway",
    "account-format": "yarn --cwd ./apps/account run format",
    "account-lint": "eslint \"./apps/account/{src,config,test}/**/*.ts\"",
    "account-prebuild": "yarn yarn --cwd ./apps/account run prebuild",
    "account-build": "nest build account",
    "account-start": "nest start account",
