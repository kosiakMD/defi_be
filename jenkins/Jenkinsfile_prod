#!/usr/bin/env groovy

pipeline {
    agent any
    parameters {
        string(name: "BRANCH_NAME", description: "Git branch to build Docker image", defaultValue: "master", trim: true)
        string(name: "REPLICAS", description: "Default amount of replicas", defaultValue: "6", trim: true)
        string(name: "TEMPLATE", description: "Default chart template", defaultValue: "1.0.3", trim: true)
    }
    options {
        buildDiscarder(
            logRotator(
                numToKeepStr: "50",
                daysToKeepStr: "60",
                artifactNumToKeepStr: "50",
                artifactDaysToKeepStr: "60"
            )
        )
    }
    environment {
        AWS_REGION          = "eu-central-1"
        DOCKER_REGISTRY     = ""
        DOCKER_IMAGE        = ""
        DOCKER_TAG          = ""
        DOCKER_REGISTRY_URL = "https://625623467395.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
        DOCKER_CREDENTIALS  = "ecr:${env.AWS_REGION}:defiyield-aws"
        SERVICE_FOLDER      = JOB_BASE_NAME.substring(0,JOB_BASE_NAME.length() - 5)
        DOCKERFILE_NAME     = "Dockerfile_${env.SERVICE_FOLDER}"
    }
    stages {
        stage("Build") {
            steps {
                script {
                    docker.withRegistry(DOCKER_REGISTRY_URL, DOCKER_CREDENTIALS) {
                        DOCKER_REGISTRY = DOCKER_REGISTRY_URL.replace("https://", "")
                        DOCKER_TAG = sh(script: "git log --pretty=tformat:'%h' -n1 ./apps/${env.SERVICE_FOLDER}", returnStdout: true).trim().take(7)
                        DOCKER_IMAGE = docker.build("${env.SERVICE_FOLDER}:${DOCKER_TAG}", "-f ./${env.DOCKERFILE_NAME} .")
                    }
                }
            }
        }
        stage("CheckECR") {
            steps {
                script {
                    sh """#!/bin/bash
                    aws ecr create-repository --region ${env.AWS_REGION} --repository-name ${env.SERVICE_FOLDER} || true
                    """
                }
            }
        }
        stage("Push") {
            steps {
                script {
                    docker.withRegistry(DOCKER_REGISTRY_URL, DOCKER_CREDENTIALS) {
                        DOCKER_IMAGE.push()
                        DOCKER_IMAGE.push("latest")
                    }
                    writeJSON(
                        file: "image.json",
                        pretty: 4,
                        json: [
                            "image": DOCKER_IMAGE.imageName(),
                            "registry": DOCKER_REGISTRY,
                            "repository": env.SERVICE_FOLDER,
                            "tag": DOCKER_TAG
                        ]
                    )
                    archiveArtifacts(
                        artifacts: "image.json",
                        fingerprint: true,
                        allowEmptyArchive: true
                    )
                }
            }
        }
        stage('Webhook') {
            steps {
                sh "python jenkins/hook.py ${env.SERVICE_FOLDER} production ${DOCKER_TAG} ${params.BRANCH_NAME} ${params.REPLICAS} ${params.TEMPLATE}"
            }
        }
    }
    post {
        always {
            cleanWs()
            script {
                currentBuild.displayName = "${env.SERVICE_FOLDER} - ${params.BRANCH_NAME} #${env.BUILD_NUMBER}"
                currentBuild.description = DOCKER_IMAGE.imageName()
            }
            sh """
                docker rmi --force \
                  ${DOCKER_IMAGE.imageName()} \
                  ${DOCKER_REGISTRY}/${env.SERVICE_FOLDER}:latest
            """
        }
    }
}
