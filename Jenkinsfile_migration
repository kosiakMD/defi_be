#!/usr/bin/env groovy

// Create and upload secret files to Jenkins credentials/store/system:
// 1. - AWS_RDS_CONFIG - AWS config file
// 2. - AWS_RDS_CREDENTIALS - AWS credentials file
// 3. - migration-test - Env file with Database env variables. For example:
//# Database
//DB_HOST=rdsname.xxxxxx.eu-central-1.rds.amazonaws.com
//DB_PORT=5432
//DB_USERNAME=admin
//DB_PASSWORD=password
//DB_DATABASE=postgres
//DB_CONNECTION=postgres

pipeline {
    agent any
    parameters {
        string(name: "BRANCH_NAME", description: "Git branch to build Docker image", defaultValue: "master", trim: true)
        string(name: "DOCKERFILE_NAME", description: "Dockerfile name to build Docker image", defaultValue: "Dockerfile_migration", trim: true)
        choice(name: 'CREATE_SNAPSHOT', choices: ['Yes', 'No'], description: 'Create RDS snapshot before migration')
    }
    options {
        buildDiscarder(
                logRotator(
                        numToKeepStr: "50",
                        daysToKeepStr: "60",
                        artifactNumToKeepStr: "50",
                        artifactDaysToKeepStr: "60"
                )
        )
    }
    environment {
        DOCKER_REGISTRY     = ""
        DOCKER_IMAGE        = ""
        DOCKER_TAG          = ""
        DOCKER_REGISTRY_URL = "https://625623467395.dkr.ecr.eu-central-1.amazonaws.com"
        DOCKER_CREDENTIALS  = "ecr:eu-central-1:defiyield-aws"

        DOCKERAWS           = "_"
        RDS_NAME            = "_"
        SNAPSHOT_NAME       = "jenkins-snapshot-before-migration"
    }
    stages {
        stage("Snapshot") {
            steps {
                withCredentials([file(credentialsId: "migration-prod", variable: "RDSENV"),
                                 file(credentialsId: "AWS_RDS_CONFIG", variable: "AWSCONFIG"),
                                 file(credentialsId: "AWS_RDS_CREDENTIALS", variable: "AWSCREDENTIALS"),]) {
                    script {
                        DOCKERAWS = "docker run --rm -i --env-file=${RDSENV} -v ${AWSCONFIG}:/root/.aws/config -v ${AWSCREDENTIALS}:/root/.aws/credentials amazon/aws-cli:2.0.6"
                        RDS_NAME = sh (
                                script: "docker run --rm --env-file=${RDSENV} alpine:3.14 sh -c 'echo \$DB_HOST' | cut -d . -f1",
                                returnStdout: true
                        ).trim()
                    }
                    sh """#!/bin/bash
                if [ "${params.CREATE_SNAPSHOT}" = "Yes" ]; then
                    echo "Delete previous snapshot"
		            ${DOCKERAWS} rds delete-db-snapshot --db-snapshot-identifier ${RDS_NAME}-${SNAPSHOT_NAME} || true
		            ${DOCKERAWS} rds db-snapshot-deleted --db-snapshot-identifier ${RDS_NAME}-${SNAPSHOT_NAME}
                    echo "Create new snapshot"
                    ${DOCKERAWS} rds create-db-snapshot --db-instance-identifier ${RDS_NAME} --db-snapshot-identifier ${RDS_NAME}-${SNAPSHOT_NAME}
		            ${DOCKERAWS} rds wait db-snapshot-completed --db-snapshot-identifier ${RDS_NAME}-${SNAPSHOT_NAME}
                 else 
                    echo 'No need snapshot'
                fi
            """
                }
            }
        }
        stage("Build") {
            steps {
                script {
                    docker.withRegistry(DOCKER_REGISTRY_URL, DOCKER_CREDENTIALS) {
                        SERVICE_FOLDER = env.JOB_BASE_NAME.replace("-", "_")
                        DOCKER_REGISTRY = DOCKER_REGISTRY_URL.replace("https://", "")
                        DOCKER_TAG = sh(script: "git log --pretty=tformat:'%h' -n1 ./${DOCKERFILE_NAME}", returnStdout: true).trim().take(7)
                        DOCKER_IMAGE = docker.build("${env.JOB_BASE_NAME}:${DOCKER_TAG}", "-f ./${DOCKERFILE_NAME} .")
                    }
                }
            }
        }
        stage("Push") {
            steps {
                script {
                    docker.withRegistry(DOCKER_REGISTRY_URL, DOCKER_CREDENTIALS) {
                        DOCKER_IMAGE.push()
                        DOCKER_IMAGE.push("latest")
                    }
                    writeJSON(
                            file: "image.json",
                            pretty: 4,
                            json: [
                                    "image": DOCKER_IMAGE.imageName(),
                                    "registry": DOCKER_REGISTRY,
                                    "repository": env.JOB_BASE_NAME,
                                    "tag": DOCKER_TAG
                            ]
                    )
                    archiveArtifacts(
                            artifacts: "image.json",
                            fingerprint: true,
                            allowEmptyArchive: true
                    )
                }
            }
        }
        stage("Run") {
            steps {
                withCredentials([file(credentialsId: "migration-prod", variable: "RDSENV")]) {
                    sh "docker run --env-file=${RDSENV} --rm ${DOCKER_REGISTRY}/${env.JOB_BASE_NAME}:latest"
                }
            }
        }

    }
    post {
        always {
            cleanWs()
            script {
                currentBuild.displayName = "${env.JOB_BASE_NAME} - ${params.BRANCH_NAME} #${env.BUILD_NUMBER}"
                currentBuild.description = DOCKER_IMAGE.imageName()
            }
            sh """
                docker rmi --force \
                  ${DOCKER_IMAGE.imageName()} \
                  ${DOCKER_REGISTRY}/${env.JOB_BASE_NAME}:latest
            """
        }
    }
}