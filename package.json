{
  "name": "defiyield-backend",
  "version": "1.0.1",
  "description": "DeFiYield Microservices",
  "scripts": {
    "pre-commit": "yarn run lint && yarn run format-check",
    "prepare": "husky install",
    "install_all": "yarn --cwd api_gateway && yarn --cwd account_service && yarn --cwd integration_service && yarn --cwd swap_service && yarn --cwd price_service",
    "install_all_prod": "yarn --prod --cwd api_gateway && yarn --prod --cwd account_service && yarn --prod --cwd integration_service && yarn --prod --cwd swap_service && yarn --prod --cwd price_service",
    "build": "yarn --cwd api_gateway build && yarn --cwd account_service build && yarn --cwd integration_service build && yarn --cwd swap_service build && yarn --cwd price_service build",
    "audit": "yarn audit --cwd api_gateway && yarn audit --cwd account_service && yarn audit --cwd integration_service && yarn audit --cwd swap_service && yarn audit --cwd price_service",
    "lint": "eslint \"**/{src,apps,libs,test}/**/*.ts\"",
    "lint-fix": "eslint \"**/{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"./**/src/**/*.ts\" \"./**/test/**/*.ts\"",
    "format-check": "prettier \"./**/src/**/*.ts\" \"./**/test/**/*.ts\" --check",
    "prebuild_gateway": "yarn run prebuild --prefix api_gateway",
    "build_gateway": "yarn run build --prefix api_gateway",
    "format_gateway": "yarn run format --prefix api_gateway",
    "start_gateway": "yarn run start --prefix api_gateway",
    "start_gateway:dev": "yarn run start --watch --prefix api_gateway",
    "start_gateway:debug": "yarn run start --debug --watch --prefix api_gateway",
    "start_gateway:prod": "yarn run start --prefix api_gateway",
    "prebuild_account": "yarn run prebuild --prefix account_service",
    "build_account": "yarn run build --prefix account_service",
    "format_account": "yarn run format --prefix account_service",
    "start_account": "yarn run start --prefix account_service",
    "start_account:dev": "yarn run start --watch --prefix account_service",
    "start_account:debug": "yarn run start --debug --watch --prefix account_service",
    "start_account:prod": "yarn run start --prefix account_service",
    "prebuild_integration": "yarn run prebuild --prefix integration_service",
    "build_integration": "yarn run build --prefix integration_service",
    "format_integration": "yarn run format --prefix integration_service",
    "start_integration": "yarn run start --prefix integration_service",
    "start_integration:dev": "yarn run start --watch --prefix integration_service",
    "start_integration:debug": "yarn run start --debug --watch --prefix integration_service",
    "start_integration:prod": "yarn run start --prefix integration_service",
    "prebuild_swap": "yarn run prebuild --prefix swap_service",
    "build_swap": "yarn run build --prefix swap_service",
    "format_swap": "yarn run format --prefix swap_service",
    "start_swap": "yarn run start --prefix swap_service",
    "start_swap:dev": "yarn run start --watch --prefix swap_service",
    "start_swap:debug": "yarn run start --debug --watch --prefix swap_service",
    "start_swap:prod": "yarn run start --prefix swap_service",
    "prebuild_price": "yarn run prebuild --prefix price_service",
    "build_price": "yarn run build --prefix price_service",
    "format_price": "yarn run format --prefix price_service",
    "start_price": "yarn run start --prefix price_service",
    "start_price:dev": "yarn run start --watch --prefix price_service",
    "start_price:debug": "yarn run start --debug --watch --prefix price_service",
    "start_price:prod": "yarn run start --prefix price_service"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defiyield-info/defiyield-backend-v2.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/defiyield-info/defiyield-backend-v2/issues"
  },
  "homepage": "https://github.com/defiyield-info/defiyield-backend-v2#readme",
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^2.0.1",
    "@types/cache-manager": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^4.19.0",
    "@typescript-eslint/parser": "^4.19.0",
    "axios": "^0.21.1",
    "danger": "^10.6.3",
    "eslint": "^7.22.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "husky": "^6.0.0",
    "nestjs-pgpromise": "^1.4.3",
    "pg-promise": "^10.10.1",
    "prettier": "^2.2.1",
    "prettier-plugin-import-sort": "0.0.6",
    "typescript": "^4.2.3"
  },
  "dependencies": {}
}
