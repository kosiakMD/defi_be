ENV=.env
SERVICE_NAME="Price Service"
SERVICE_HOST=
SERVICE_PORT=

LOG_ERROR_FILE=error.log
LOG_COMBINED_FILE=combined.log
LOG_LEVEL=info


DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SCHEMA=
DB_SYNCHRONIZE=false
DB_LOGGING=true
DB_ENTITIES=entities/**/*.ts

BODY_LIMIT=50mb

THEGRAPH_UNISWAP_ENDPOINT=https://api.thegraph.com/subgraphs/name/tretiakpk/uniswap-v2
THEGRAPH_SUSHISWAP_ENDPOINT=https://api.thegraph.com/subgraphs/name/tretiakpk/sushiswap-fork-of-uniswap-v2
THEGRAPH_CURVE_ENDPOINT=https://api.thegraph.com/subgraphs/name/tretiakpk/curve
THEGRAPH_BALANCER_ENDPOINT=https://api.thegraph.com/subgraphs/name/dashvm7/balancer
SWAP_0X_ENDPOINT=https://api.0x.org/swap/v1/

ETH_URL=https://mainnet.infura.io/v3/d38bddd842b94305a23f91596991a9eb
BSC_URL=https://bsc-dataseed.binance.org/

