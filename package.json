{
  "name": "defiyield-backend",
  "version": "1.0.1",
  "description": "DeFiYield Microservices",
  "engines": {
    "node": ">=14",
    "npm": "^6.11.0 || ^7.5.6",
    "yarn": ">=1.13.0"
  },
  "scripts": {
    "pre-commit": "yarn run lint && yarn run format-check",
    "prepare": "husky install",
    "build-monorepo": "yarn common-build && yarn gateway-build && yarn account-build && yarn integration-build && yarn price-build",
    "lint": "eslint \"**/{src,apps,libs,test}/**/*.ts\"",
    "lint-fix": "eslint \"**/{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format-check": "prettier \"./**/src/**/*.ts\" \"./**/test/**/*.ts\" --check",
    "common-build": "nest build common",
    "gateway-prebuild": "yarn --cwd ./apps/api_gateway run prebuild",
    "gateway-format": "yarn --cwd ./apps/api_gateway run format",
    "gateway-lint": "eslint \"./apps/api_gateway/{src,config,test}/**/*.ts\"",
    "gateway-build": "nest build api_gateway",
    "gateway-start:dev": "nest start api_gateway --watch",
    "gateway-start:debug": "nest start api_gateway --debug --watch",
    "gateway-start:prod": "nest start api_gateway",
    "account-format": "yarn --cwd ./apps/account_service run format",
    "account-lint": "eslint \"./apps/account_service/{src,config,test}/**/*.ts\"",
    "account-prebuild": "yarn yarn --cwd ./apps/account_service run prebuild",
    "account-build": "nest build account_service",
    "account-start": "nest start account_service",
    "account-start:dev": "nest start account_service --watch",
    "account-start:debug": "nest start account_service --debug --watch",
    "account-start:prod": "nest start account_service",
    "integration-format": "yarn --cwd ./apps/integration_service run format",
    "integration-lint": "eslint \"./apps/integration_service/{src,config}/**/*.ts\"",
    "integration-prebuild": "yarn yarn --cwd ./apps/integration_service run prebuild",
    "integration-build": "nest build integration_service",
    "integration-start": "nest start integration_service",
    "integration-start:dev": "nest start integration_service --watch",
    "integration-start:debug": "nest start integration_service --debug --watch",
    "integration-start:prod": "nest start integration_service",
    "price-format": "yarn --cwd ./apps/price_service run format",
    "price-lint": "eslint \"./apps/price_service/{src,config}/**/*.ts\"",
    "price-prebuild": "yarn yarn --cwd ./apps/price_service run prebuild",
    "price-build": "nest build price_service",
    "price-start": "nest start price_service",
    "price-start:dev": "nest start price_service --watch",
    "price-start:debug": "nest start price_service --debug --watch",
    "price-start:prod": "nest start price_service",
    "prebuild_price": "yarn run prebuild --prefix price_service",
    "build_price": "yarn run build --prefix price_service",
    "format_price": "yarn run format --prefix price_service",
    "start_price": "yarn run start --prefix price_service",
    "start_price:dev": "yarn run start --watch --prefix price_service",
    "start_price:debug": "yarn run start --debug --watch --prefix price_service",
    "start_price:prod": "yarn run start --prefix price_service"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defiyield-info/defiyield-backend-v2.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/defiyield-info/defiyield-backend-v2/issues"
  },
  "homepage": "https://github.com/defiyield-info/defiyield-backend-v2#readme",
  "devDependencies": {
    "@nestjs/cli": "7.6.0",
    "@nestjs/config": "^0.6.3",
    "@nestjs/schematics": "^7.3.1",
    "@nestjs/testing": "^7.6.18",
    "@trivago/prettier-plugin-sort-imports": "^2.0.1",
    "@types/cache-manager": "^3.4.0",
    "@types/express": "^4.17.11",
    "@types/jest": "^26.0.21",
    "@types/node": "^14.14.31",
    "@types/supertest": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^4.19.0",
    "@typescript-eslint/parser": "^4.19.0",
    "danger": "^10.6.3",
    "eslint": "^7.22.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.3.1",
    "hasura-cli": "^2.0.5",
    "husky": "^6.0.0",
    "nestjs-pgpromise": "^1.4.3",
    "pg-promise": "^10.10.1",
    "prettier": "^2.2.1",
    "prettier-plugin-import-sort": "0.0.6",
    "typescript": "^4.2.3"
  },
  "dependencies": {
    "@ethersproject/providers": "5.4.5",
    "@indexed-finance/multicall": "^2.0.0",
    "@nestjs-modules/mailer": "^1.6.0",
    "@nestjs/common": "^7.6.18",
    "@nestjs/config": "^0.6.3",
    "@nestjs/core": "^7.6.18",
    "@nestjs/platform-express": "^7.6.18",
    "@nestjs/swagger": "^4.8.2",
    "@nestjs/terminus": "^7.2.0",
    "@nestjs/typeorm": "^7.1.5",
    "@nestjsx/api-version": "^0.1.1",
    "bignumber.js": "^9.0.1",
    "cache-manager": "^3.4.3",
    "cache-manager-redis-store": "^2.0.0",
    "class-transformer": "^0.4.0",
    "class-validator": "^0.13.1",
    "dotenv": "^10.0.0",
    "ethers": "^5.0.19",
    "http-proxy-middleware": "^1.1.0",
    "joi": "^17.4.0",
    "limiter": "^2.1.0",
    "nest-winston": "^1.4.1",
    "nodemailer": "^6.6.1",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
    "rxjs": "^7.3.0",
    "source-map-support": "^0.5.20",
    "swagger-ui-express": "^4.1.6",
    "ts-loader": "^8.0.17",
    "typeorm": "^0.2.37",
    "web3": "^1.6.0",
    "winston": "^3.3.3",
    "winston-aws-cloudwatch": "^3.0.0"
  }
}
