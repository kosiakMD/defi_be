ENV=.env
# SERVICE
SERVICE_NAME="API Gateway"
SERVICE_HOST=
SERVICE_PORT=3000
# LOG
LOG_ERROR_FILE=error.log
LOG_COMBINED_FILE=combined.log
LOG_LEVEL=info
# ACCOUNT
ACCOUNT_SERVICE_HOST=
ACCOUNT_SERVICE_PORT=
ACCOUNT_STATUS=v1/status
ACCOUNT_TRANSACTIONS=v1/transactions
ACCOUNT_BALANCE=v1/balances
ACCOUNT_APPROVALS=v1/approvals
POOLS_PATH=v1/pools
VAULTS_PATH=v1/vaults
# PRICE
PRICE_SERVICE_HOST=
PRICE_SERVICE_PORT=
PRICE_STATUS=v1/status
PRICES_PATH=v1/prices
PRICE_CHAINS_PATH=v1/chains
PRICE_CURRENCIES_PATH=v1/currencies
# INTEGRATION
INTEGRATION_SERVICE_HOST=
INTEGRATION_SERVICE_PORT=3005
INTEGRATION_STATUS=v1/status
INTEGRATION_UNISWAP=/v1/integration/uniswap
INTEGRATION_SUSHISWAP=v1/integration/sushiswap
INTEGRATION_BALANCER=v1/integration/balancer
INTEGRATION_PANCAKE=v1/integration/pancake
INTEGRATION_CURVE=v1/integration/curve
#
DEFIYIELD_INFO_2_URL=https://api2.defiyield.info
TOKENS_PATH=tokens
GAS_HISTORY_PATH=gas-hist

DEFIYIELD_INFO_MAIN_URL=https://apimain.defiyield.info
APPROVALS_PATH=tool/approvals/eth

GAS_API_URL=https://www.gasnow.org/api/v3
GAS_CURRENT_PATH=gas/price?utm_source=defi

