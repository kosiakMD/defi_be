{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2017",
		"lib": [
			"es5",
			"es6",
			"dom",
			"es2019",
			"es2020"
		],
		"declaration": true,
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"sourceMap": true,
		"outDir": "./dist",
		"baseUrl": "./",
		"incremental": true
	}
}